# ================================================================
# 3. CONFIGURACIÓN GENERAL
# ================================================================

SEED = 42

np.random.seed(SEED)
tf.random.set_seed(SEED)

# Cuencas
CUENCAS = [
    "Yaque_del_Norte",
    "Yuna",
    "Nizao"
]

# Horas de historia utilizadas para predecir
HISTORIA = 72

# Horizontes de predicción
HORIZONTES = [24, 48, 72]

# Parámetros de entrenamiento
BATCH_SIZE = 64
EPOCHS = 100
LEARNING_RATE = 0.001

print("Historia:", HISTORIA, "horas")
print("Horizontes:", HORIZONTES)


# ================================================================
# 4. CARGA DE DATOS
# ================================================================
#
# Formato esperado:
#
# fecha, precipitacion, temperatura, caudal
#
# Ejemplo:
#
# 2020-01-01 00:00, 0.0, 24.3, 18.5
# 2020-01-01 01:00, 2.3, 24.1, 19.1
#
# precipitacion = mm/h
# temperatura   = °C
# caudal        = m3/s
#
# ================================================================


def cargar_datos(archivo):

    df = pd.read_csv(archivo)

    # Convertir fecha
    df["fecha"] = pd.to_datetime(df["fecha"])

    # Orden cronológico
    df = df.sort_values("fecha")

    # Eliminar duplicados
    df = df.drop_duplicates("fecha")

    # Índice temporal
    df = df.set_index("fecha")

    return df


# ================================================================
# 5. CONTROL DE CALIDAD
# ================================================================

def control_calidad(df):

    columnas = [
        "precipitacion",
        "temperatura",
        "caudal"
    ]

    for c in columnas:

        if c not in df.columns:
            raise ValueError(
                f"No existe la columna: {c}"
            )

    # Valores negativos de precipitación
    df["precipitacion"] = df["precipitacion"].clip(lower=0)

    # Caudal no negativo
    df["caudal"] = df["caudal"].clip(lower=0)

    # Interpolación temporal
    df["precipitacion"] = (
        df["precipitacion"]
        .interpolate(method="time")
    )

    df["temperatura"] = (
        df["temperatura"]
        .interpolate(method="time")
    )

    df["caudal"] = (
        df["caudal"]
        .interpolate(method="time")
    )

    return df


# ================================================================
# 6. CONSTRUCCIÓN DE SECUENCIAS TEMPORALES
# ================================================================

def crear_secuencias(
    df,
    historia=72,
    horizonte=24
):

    variables = [
        "precipitacion",
        "temperatura",
        "caudal"
    ]

    X = []
    y = []

    datos = df[variables].values

    for i in range(
        historia,
        len(datos) - horizonte + 1
    ):

        # Historia
        secuencia = datos[
            i-historia:i
        ]

        # Futuro
        objetivo = datos[
            i:i+horizonte,
            2
        ]

        X.append(secuencia)
        y.append(objetivo)

    return np.array(X), np.array(y)


# ================================================================
# 7. DIVISIÓN TEMPORAL
# ================================================================

def dividir_temporalmente(
    X,
    y,
    train_ratio=0.60,
    val_ratio=0.20
):

    n = len(X)

    n_train = int(n * train_ratio)

    n_val = int(
        n * (train_ratio + val_ratio)
    )

    X_train = X[:n_train]
    y_train = y[:n_train]

    X_val = X[n_train:n_val]
    y_val = y[n_train:n_val]

    X_test = X[n_val:]
    y_test = y[n_val:]

    return (
        X_train,
        X_val,
        X_test,
        y_train,
        y_val,
        y_test
    )


# ================================================================
# 8. NORMALIZACIÓN
# ================================================================

def normalizar_datos(
    X_train,
    X_val,
    X_test,
    y_train,
    y_val,
    y_test
):

    scaler_X = StandardScaler()
    scaler_y = StandardScaler()

    n_timesteps = X_train.shape[1]
    n_features = X_train.shape[2]

    # Reestructuración
    X_train_2d = X_train.reshape(
        -1,
        n_features
    )

    X_val_2d = X_val.reshape(
        -1,
        n_features
    )

    X_test_2d = X_test.reshape(
        -1,
        n_features
    )

    # Ajustar solamente con entrenamiento
    scaler_X.fit(X_train_2d)

    X_train_scaled = scaler_X.transform(
        X_train_2d
    ).reshape(
        X_train.shape
    )

    X_val_scaled = scaler_X.transform(
        X_val_2d
    ).reshape(
        X_val.shape
    )

    X_test_scaled = scaler_X.transform(
        X_test_2d
    ).reshape(
        X_test.shape
    )

    # Caudal
    scaler_y.fit(
        y_train.reshape(-1, 1)
    )

    y_train_scaled = scaler_y.transform(
        y_train.reshape(-1, 1)
    ).reshape(y_train.shape)

    y_val_scaled = scaler_y.transform(
        y_val.reshape(-1, 1)
    ).reshape(y_val.shape)

    y_test_scaled = scaler_y.transform(
        y_test.reshape(-1, 1)
    ).reshape(y_test.shape)

    return (
        X_train_scaled,
        X_val_scaled,
        X_test_scaled,
        y_train_scaled,
        y_val_scaled,
        y_test_scaled,
        scaler_X,
        scaler_y
    )


# ================================================================
# 9. ARQUITECTURA HYDROLSTM
# ================================================================

def construir_hydrolstm(
    historia,
    n_features,
    horizonte
):

    entrada = Input(
        shape=(
            historia,
            n_features
        )
    )

    # Primera capa temporal
    x = LSTM(
        128,
        return_sequences=True
    )(entrada)

    x = LayerNormalization()(x)

    x = Dropout(0.20)(x)

    # Segunda capa
    x = LSTM(
        64,
        return_sequences=True
    )(x)

    x = LayerNormalization()(x)

    x = Dropout(0.20)(x)

    # Tercera capa
    x = LSTM(
        32,
        return_sequences=False
    )(x)

    x = Dropout(0.20)(x)

    # Representación hidrológica
    x = Dense(
        64,
        activation="tanh"
    )(x)

    x = Dense(
        32,
        activation="tanh"
    )(x)

    # Salida multipaso
    salida = Dense(
        horizonte,
        activation="linear"
    )(x)

    modelo = Model(
        inputs=entrada,
        outputs=salida
    )

    modelo.compile(
        optimizer=Adam(
            learning_rate=LEARNING_RATE
        ),
        loss="mse",
        metrics=[
            "mae"
        ]
    )

    return modelo


# ================================================================
# 10. MÉTRICAS HIDROLÓGICAS
# ================================================================

def calcular_nse(y_true, y_pred):

    denominador = np.sum(
        (y_true - np.mean(y_true)) ** 2
    )

    numerador = np.sum(
        (y_true - y_pred) ** 2
    )

    if denominador == 0:
        return np.nan

    return 1 - numerador / denominador


def calcular_kge(y_true, y_pred):

    r = np.corrcoef(
        y_true,
        y_pred
    )[0, 1]

    alpha = (
        np.std(y_pred) /
        np.std(y_true)
    )

    beta = (
        np.mean(y_pred) /
        np.mean(y_true)
    )

    return 1 - np.sqrt(
        (r - 1)**2 +
        (alpha - 1)**2 +
        (beta - 1)**2
    )


def calcular_metricas(
    y_true,
    y_pred
):

    y_true = np.asarray(
        y_true
    ).flatten()

    y_pred = np.asarray(
        y_pred
    ).flatten()

    mae = mean_absolute_error(
        y_true,
        y_pred
    )

    rmse = np.sqrt(
        mean_squared_error(
            y_true,
            y_pred
        )
    )

    r2 = r2_score(
        y_true,
        y_pred
    )

    nse_value = calcular_nse(
        y_true,
        y_pred
    )

    kge_value = calcular_kge(
        y_true,
        y_pred
    )

    return {
        "MAE": mae,
        "RMSE": rmse,
        "R2": r2,
        "NSE": nse_value,
        "KGE": kge_value
    }


# ================================================================
# 11. NULL MODEL
# ================================================================
#
# El Null Model utiliza como predicción futura
# el último caudal observado:
#
# Q(t+1) = Q(t)
# Q(t+2) = Q(t)
# ...
#
# Es una referencia persistente ("persistence model").
#
# ================================================================

def null_model(
    X_original,
    horizonte
):

    # El caudal es la tercera variable
    ultimo_caudal = X_original[
        :, -1, 2
    ]

    pred = np.repeat(
        ultimo_caudal.reshape(-1, 1),
        horizonte,
        axis=1
    )

    return pred


# ================================================================
# 12. ENTRENAMIENTO COMPLETO
# ================================================================

def entrenar_modelo(
    df,
    horizonte
):

    print("\n")
    print("="*70)
    print(
        f"HYDROLSTM - HORIZONTE {horizonte} HORAS"
    )
    print("="*70)

    # Crear secuencias
    X, y = crear_secuencias(
        df,
        HISTORIA,
        horizonte
    )

    print(
        "Número de secuencias:",
        len(X)
    )

    # División temporal
    (
        X_train,
        X_val,
        X_test,
        y_train,
        y_val,
        y_test
    ) = dividir_temporalmente(
        X,
        y
    )

    # Normalización
    (
        X_train_s,
        X_val_s,
        X_test_s,
        y_train_s,
        y_val_s,
        y_test_s,
        scaler_X,
        scaler_y
    ) = normalizar_datos(
        X_train,
        X_val,
        X_test,
        y_train,
        y_val,
        y_test
    )

    # Modelo
    modelo = construir_hydrolstm(
        HISTORIA,
        X.shape[2],
        horizonte
    )

    modelo.summary()

    # Callbacks
    early_stop = EarlyStopping(
        monitor="val_loss",
        patience=15,
        restore_best_weights=True
    )

    reduce_lr = ReduceLROnPlateau(
        monitor="val_loss",
        factor=0.5,
        patience=7,
        min_lr=1e-6
    )

    checkpoint = ModelCheckpoint(
        f"HydroLSTM_{horizonte}h.keras",
        monitor="val_loss",
        save_best_only=True
    )

    # Entrenamiento
    history = modelo.fit(
        X_train_s,
        y_train_s,
        validation_data=(
            X_val_s,
            y_val_s
        ),
        epochs=EPOCHS,
        batch_size=BATCH_SIZE,
        callbacks=[
            early_stop,
            reduce_lr,
            checkpoint
        ],
        verbose=1
    )

    # Predicción
    y_pred_s = modelo.predict(
        X_test_s
    )

    # Desnormalizar
    y_pred = scaler_y.inverse_transform(
        y_pred_s.reshape(-1, 1)
    ).reshape(
        y_pred_s.shape
    )

    y_real = y_test

    # ============================================================
    # NULL MODEL
    # ============================================================

    y_null = null_model(
        X_test,
        horizonte
    )

    # ============================================================
    # MÉTRICAS GLOBALES
    # ============================================================

    metricas_hydro = calcular_metricas(
        y_real,
        y_pred
    )

    metricas_null = calcular_metricas(
        y_real,
        y_null
    )

    print("\nRESULTADOS HYDROLSTM")
    print(metricas_hydro)

    print("\nRESULTADOS NULL MODEL")
    print(metricas_null)

    # ============================================================
    # REDUCCIÓN DEL ERROR
    # ============================================================

    reduccion_mae = (
        1 -
        metricas_hydro["MAE"] /
        metricas_null["MAE"]
    ) * 100

    reduccion_rmse = (
        1 -
        metricas_hydro["RMSE"] /
        metricas_null["RMSE"]
    ) * 100

    print(
        f"\nReducción MAE: "
        f"{reduccion_mae:.2f}%"
    )

    print(
        f"Reducción RMSE: "
        f"{reduccion_rmse:.2f}%"
    )

    # ============================================================
    # RESULTADOS
    # ============================================================

    resultados = {
        "Horizonte_h": horizonte,

        "HydroLSTM_MAE":
            metricas_hydro["MAE"],

        "Null_MAE":
            metricas_null["MAE"],

        "Reduccion_MAE_%":
            reduccion_mae,

        "HydroLSTM_RMSE":
            metricas_hydro["RMSE"],

        "Null_RMSE":
            metricas_null["RMSE"],

        "Reduccion_RMSE_%":
            reduccion_rmse,

        "HydroLSTM_R2":
            metricas_hydro["R2"],

        "HydroLSTM_NSE":
            metricas_hydro["NSE"],

        "HydroLSTM_KGE":
            metricas_hydro["KGE"],

        "Null_R2":
            metricas_null["R2"],

        "Null_NSE":
            metricas_null["NSE"],

        "Null_KGE":
            metricas_null["KGE"]
    }

    return (
        modelo,
        history,
        resultados,
        y_real,
        y_pred,
        y_null
    )


