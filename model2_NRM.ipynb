# 21. ANÁLISIS DE EVENTOS EXTREMOS
# ================================================================
#
# Se consideran eventos extremos aquellos donde el caudal
# observado supera el percentil 95.
#
# ================================================================

def analizar_eventos_extremos(
    y_real,
    y_pred,
    y_null
):

    real_flat = y_real.flatten()

    pred_flat = y_pred.flatten()

    null_flat = y_null.flatten()

    umbral = np.percentile(
        real_flat,
        95
    )

    mascara = (
        real_flat >= umbral
    )

    real_extremo = (
        real_flat[mascara]
    )

    pred_extremo = (
        pred_flat[mascara]
    )

    null_extremo = (
        null_flat[mascara]
    )

    metricas_hydro = calcular_metricas(
        real_extremo,
        pred_extremo
    )

    metricas_null = calcular_metricas(
        real_extremo,
        null_extremo
    )

    return (
        umbral,
        metricas_hydro,
        metricas_null
    )


